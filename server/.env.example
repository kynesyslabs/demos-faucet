# Demos faucet server. Every limit below is an example for the beta mainnet,
# where DEM has no market value and the faucet is the only source of supply;
# the operator sets the real values. A malformed or zero limit stops startup.

# Faucet wallet mnemonic (the address must be funded in genesis). Keep secret.
MNEMONIC=example twelve word mnemonic phrase goes here for wallet authentication
# RPC endpoint of a node on the target network, e.g. https://<your-node-host>
RPC_URL=
PORT=3000

# Window, in seconds, shared by every cap below (sliding: a request stops
# counting TIME_INTERVAL seconds after it was made).
TIME_INTERVAL=86400

# Per request and per address per window, in whole DEM.
MAX_AMOUNT=100
# Requests per address per window.
NUMBER_PER_INTERVAL=1

# Per client IP per window (IPv6 counted per /64). Must be >= MAX_AMOUNT.
MAX_AMOUNT_PER_IP=300
NUMBER_PER_IP_PER_INTERVAL=3

# Total DEM the faucet hands out per window across all users.
GLOBAL_MAX_AMOUNT_PER_INTERVAL=50000

# Number of reverse proxies in front of the server that append the client
# address to X-Forwarded-For (1 = one nginx/Caddy; 2 = CDN + nginx; 0 = none,
# the socket peer is the client). Too high lets clients forge their IP.
TRUST_PROXY_HOPS=1

# Max wait for a transfer to reach a terminal on-chain state, in ms. On
# timeout the request's allowance stays used because the tx may still land.
TRANSFER_TIMEOUT_MS=60000
# Requests allowed to wait for the single in-flight transfer before new ones
# get 503.
MAX_PENDING_TRANSFERS=10

# SQLite file holding the request history the caps are counted from.
FAUCET_DB_PATH=faucet.db

# Comma-separated browser origins allowed by CORS (frontend URL).
CORS_ORIGINS=https://faucet.demos.sh,http://localhost:4442
